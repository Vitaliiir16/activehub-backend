@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members
title ActiveHub implementation: TypeScript types, function modules and PostgreSQL records
package "Presentation" {
 class ReactApplication <<module>> {
  +SessionProvider
  +App()
  +SessionProvider()
}
 class ApiClient <<module>> {
  +createApi()
  +quoteBooking()
  +createBooking()
}
 class NextRoutes <<module>> {
  +handler()
  +GET()
  +POST()
}
}
package "Application functions (actual modules, not runtime service classes)" {
 class Accounts <<module>> {
  +register()
  +login()
  +applyProfile()
}
 class Catalog <<module>> {
  +listEvents()
  +createEvent()
  +cancelEventCascade()
}
 class Bookings <<module>> {
  +previewBooking()
  +createBooking()
  +lockBooking()
  +transition()
}
 class Payments <<module>> {
  +payBooking()
  +refundBooking()
}
 class Subscriptions <<module>> {
  +savePlan()
  +purchaseSubscription()
  +reserveVisits()
  +returnVisits()
}
 class Loyalty <<module>> {
  +quoteBooking()
  +accruePoints()
  +releaseLoyalty()
  +syncCard()
}
 class Chat <<module>> {
  +createConversation()
  +sendMessage()
  +readConversation()
}
 class Administration <<module>> {
  +listAccounts()
  +deleteAccount()
  +editDictionaryItem()
}
 class Statistics <<module>> {
  +organizerDashboard()
  +platformStatistics()
}
}
package "Domain types and persisted entities" {
 class Account <<SQL>> {
  +id
  +role
  +status
  +email
  -password_hash
}
 class UserProfile <<SQL>> {
  +loyalty_level
  +base_level
  +points_balance
  +lifetime_points
}
 class OrganizerProfile <<SQL>> {
  +name
  +type
  +city_id
}
 class AdminProfile <<SQL>> {
  +display_name
  +created_by
}
 class City <<SQL>>
 class Direction <<SQL>>
 class EventRow <<type / SQL>> {
  +organizer_id
  +kind
  +price_minor
  +status
  +address_version
}
 class SessionRow <<type / SQL>> {
  +starts_at
  +ends_at
  +seats_total
  +status
  +time_version
}
 class EventPhoto <<SQL>> {
  +filename
  +position
}
 class BookingRow <<type / SQL>> {
  +seats
  +status
  +amount_due_minor
  +subscription_id
  +points_awarded
}
 class BookingHistory <<SQL>> {
  +from_status
  +to_status
  +actor_role
  +reason
}
 class Payment <<SQL>> {
  +amount_minor
  +status
  +card_last4
}
 class Refund <<SQL>> {
  +payment_id
  +amount_minor
}
 class SubscriptionPlan <<SQL>> {
  +type
  +validity_days
  +visits_limit
  +scope
  +status
}
 class UserSubscription <<SQL>> {
  +plan_snapshot
  +visits_left
  +expires_at
  +status
}
 class VisitLedger <<SQL>> {
  +booking_id
  +visits
  +returned_at
}
 class PointsTransaction <<SQL>> {
  +delta
  +reason
  +booking_id
}
 class FreeVisitLedger <<SQL>> {
  +quota_month
  +visits
  +returned_at
}
 class LoyaltySettings <<SQL>> {
  +levels
  +rules
  +free_directions
}
 class Conversation <<SQL>> {
  +user_id
  +organizer_id
  +last_seq
}
 class Message <<SQL>> {
  +seq
  +sender_id
  +body
  +read_at
}
}
package "Implemented variation policies" {
 interface SeatPolicy {
  +validate(seats)
  +exclusive
}
 class OrdinarySeats <<strategy object>>
 class SingleParticipant <<strategy object>>
 class ExclusiveHall <<strategy object>>
 abstract class PriceStep {
  +then(next)
  +apply(context)
  #handle(context)
}
 class PromotionStep
 class FreeAccessStep
 class CardDiscountStep
 interface PaymentGateway {
  +charge(card)
}
 class SimulatedCardGateway <<Adapter>> {
  +charge(card)
}
}
package "Infrastructure" {
 class Worker <<process>> {
  +runBookingJobs()
  +expireSubscriptions()
  +runReminderJobs()
  +dispatchEmails()
}
 interface MailTransport {
  +send(mail)
}
 class SmtpMailTransport <<Adapter>> {
  +send(mail)
}
 class Notification <<SQL>> {
  +event_key
  +account_id
  +email_status
}
 class EmailOutbox <<SQL>> {
  +state
  +attempts
  +next_attempt_at
}
 class BackgroundRuns <<SQL>> {
  +next_run_at
  +finished_at
}
 class IdempotencyRecords <<SQL>> {
  +scope
  +key
  +fingerprint
  +response_body
}
 class SessionAndCsrf <<SQL>> {
  -token_hash
  -csrf_hash
  +expires_at
}
 class AuditLog <<SQL>>
}
ReactApplication --> ApiClient
ApiClient --> NextRoutes
NextRoutes --> Accounts
NextRoutes --> Catalog
NextRoutes --> Bookings
NextRoutes --> Payments
NextRoutes --> Subscriptions
NextRoutes --> Chat
NextRoutes --> Administration
NextRoutes --> Statistics
Account "1" -- "0..1" UserProfile
Account "1" -- "0..1" OrganizerProfile
Account "1" -- "0..1" AdminProfile
UserProfile --> City
OrganizerProfile --> City
UserProfile "*" -- "*" Direction : preferences
OrganizerProfile "1" -- "*" EventRow
EventRow --> City
EventRow --> Direction
EventRow "1" *-- "*" SessionRow
EventRow "1" *-- "0..8" EventPhoto
SessionRow "1" -- "*" BookingRow
UserProfile "1" -- "*" BookingRow
BookingRow "1" -- "*" BookingHistory
BookingRow "0..1" -- "*" Payment
Payment "1" -- "0..1" Refund
OrganizerProfile "1" -- "*" SubscriptionPlan
SubscriptionPlan "1" -- "*" UserSubscription : immutable purchase snapshot
UserProfile "1" -- "*" UserSubscription
UserSubscription "1" -- "*" VisitLedger
BookingRow "1" -- "0..1" VisitLedger
UserSubscription "0..1" -- "*" Payment : purchase
UserProfile "1" -- "*" PointsTransaction
BookingRow "0..1" -- "*" PointsTransaction
BookingRow "1" -- "0..1" FreeVisitLedger
Loyalty --> LoyaltySettings
Account "1" -- "*" SessionAndCsrf
Account "1" -- "*" Notification
Notification "1" -- "0..1" EmailOutbox
Conversation "1" *-- "*" Message
Conversation --> UserProfile
Conversation --> OrganizerProfile
Message --> Account : sender
Bookings --> SeatPolicy
OrdinarySeats ..|> SeatPolicy
SingleParticipant ..|> SeatPolicy
ExclusiveHall ..|> SeatPolicy
Bookings --> Loyalty
Bookings --> Subscriptions
Bookings --> Payments : compensation
Loyalty --> PriceStep
PromotionStep --|> PriceStep
FreeAccessStep --|> PriceStep
CardDiscountStep --|> PriceStep
PriceStep o--> PriceStep : next
Payments --> PaymentGateway
Subscriptions --> PaymentGateway
SimulatedCardGateway ..|> PaymentGateway
Worker --> Bookings
Worker --> Subscriptions
Worker --> BackgroundRuns
Worker --> EmailOutbox
Worker --> MailTransport
SmtpMailTransport ..|> MailTransport
Administration --> Bookings : reuse cascades
Administration --> AuditLog
Bookings --> IdempotencyRecords
Chat --> Notification
note bottom
Source index: ARCHITECTURE.md. Module boxes group real functions; they are not invented runtime classes.
PostgreSQL owns transactions, constraints, state and deduplication. State/Observer/Singleton are not claimed GoF implementations.
end note
@enduml
