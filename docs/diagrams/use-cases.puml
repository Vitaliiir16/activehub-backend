@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
title ActiveHub use cases - planned product behavior
actor Guest
actor User
actor Organizer
actor Administrator
actor "Scheduler / system" as System
rectangle ActiveHub {
 package Authentication {
  usecase "G1 Register user" as G1
  usecase "G2 Register organizer" as G2
  usecase "G3 Sign in" as G3
  usecase "G4 Recover password [S]" as G4
 }
 package "User workspace" {
  usecase "U1 Browse event board" as U1
  usecase "U2 Search and filter events" as U2
  usecase "U3 View event" as U3
  usecase "U4 Browse organizers / profile" as U4
  usecase "U5 Book session" as U5
  usecase "U6 Pay for booking" as U6
  usecase "U7 Cancel booking" as U7
  usecase "U8 View bookings / calendar" as U8
  usecase "U9 Message organizer" as U9
  usecase "U10 Purchase subscription" as U10
  usecase "U11 View subscriptions" as U11
  usecase "U12 View card / points" as U12
  usecase "U13 Edit profile / preferences" as U13
  usecase "U14 Set email preferences" as U14
  usecase "U15 Read notifications" as U15
  usecase "U16 Change password" as U16
 }
 package "Organizer workspace" {
  usecase "O1 View own dashboard" as O1
  usecase "O2 Create event" as O2
  usecase "O3 Edit event" as O3
  usecase "O4 Manage sessions" as O4
  usecase "O5 Pause / resume event" as O5
  usecase "O6 Cancel / delete event" as O6
  usecase "O7 View event bookings" as O7
  usecase "O8 Approve / reject request" as O8
  usecase "O9 Cancel booking" as O9
  usecase "O10 Message eligible user" as O10
  usecase "O11 Manage subscription plans" as O11
  usecase "O12 Edit organization profile" as O12
  usecase "O13 Read notifications" as O13
  usecase "O14 View session calendar [S]" as O14
 }
 package Administration {
  usecase "A1 View platform statistics" as A1
  usecase "A2 Manage users / cards / points" as A2
  usecase "A3 Manage organizers" as A3
  usecase "A4 Moderate / manage events" as A4
  usecase "A5 View / cancel bookings" as A5
  usecase "A6 Manage cities / directions" as A6
  usecase "A7 Configure loyalty" as A7
  usecase "A8 Create administrator" as A8
  usecase "A9 View / archive plans" as A9
 }
 package "Scheduled behavior" {
  usecase "S1 Expire bookings" as S1
  usecase "S2 Complete sessions / bookings" as S2
  usecase "S3 Send reminders" as S3
  usecase "S4 Deliver queued email" as S4
  usecase "S5 Award points / upgrade card" as S5
  usecase "S6 Expire subscriptions" as S6
  usecase "S7 Refund cancelled bookings" as S7
 }
 package "Shared behavior" {
  usecase "Calculate price snapshot" as Pricing
  usecase "Choose subscription" as SubscriptionChoice
  usecase "Redeem points [S]" as Redeem
  usecase "Commit booking confirmation" as Confirm
  usecase "Create notification intents" as Notify
  usecase "Restore reserved resources" as Restore
  usecase "Verify role / ownership / status" as Access
 }
}
