COMPOSE_PROJECT_NAME=activehub
POSTGRES_DB=activehub
POSTGRES_USER=activehub
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=ReplaceWithYourOwnPassword123
INITIAL_ADMIN_NAME=Initial Administrator
API_PORT=3000
FRONTEND_PORT=8080
MAILPIT_PORT=8025
NEXT_TELEMETRY_DISABLED=1
SESSION_TTL_SECONDS=604800
# Optional exact allowed origins, separated by commas. Compose supplies its localhost ports by default.
# APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Booking deadlines in seconds; the booking cutoff is inclusive.
BOOKING_CUTOFF_SECONDS=1800
CANCELLATION_CUTOFF_SECONDS=43200
PAYMENT_DEADLINE_SECONDS=3600
PENDING_DEADLINE_SECONDS=172800
BOOKING_WORKER_INTERVAL_SECONDS=60
PAYMENT_SIMULATION_MS=1250
