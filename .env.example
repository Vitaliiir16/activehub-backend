COMPOSE_PROJECT_NAME=activehub
POSTGRES_DB=activehub
POSTGRES_USER=activehub
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=ReplaceWithYourOwnPassword123
INITIAL_ADMIN_NAME=Initial Administrator
API_PORT=3000
FRONTEND_PORT=8080
MAILPIT_PORT=8025
NEXT_TELEMETRY_DISABLED=1
SESSION_TTL_SECONDS=604800
# Optional exact allowed origins, separated by commas. Compose supplies its localhost ports by default.
# APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Booking deadlines in seconds; the booking cutoff is inclusive.
BOOKING_CUTOFF_SECONDS=1800
CANCELLATION_CUTOFF_SECONDS=43200
PAYMENT_DEADLINE_SECONDS=3600
PENDING_DEADLINE_SECONDS=172800
BOOKING_WORKER_INTERVAL_SECONDS=60
PAYMENT_SIMULATION_MS=1250

# Email. By default every message is captured by Mailpit (http://localhost:8025) and nothing leaves your machine.
# To send real email, for example through Gmail, set an app password (Google account > Security > 2-Step Verification
# > App passwords) and uncomment these lines. Port 587 uses STARTTLS; port 465 with SMTP_SECURE=true uses implicit TLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=your.address@gmail.com
# SMTP_FROM_NAME=ActiveHub
# Public address used in email links. Defaults to http://localhost:FRONTEND_PORT.
# APP_PUBLIC_URL=https://activehub.example.com
# Reminder lead times in seconds (24 hours and 2 hours by default) and delivery attempts before an email is marked failed.
# REMINDER_FIRST_SECONDS=86400
# REMINDER_SECOND_SECONDS=7200
# EMAIL_MAX_ATTEMPTS=50

# Explicit demonstration dataset; credentials are required only when enabled.
SEED_DEMO=false
DEMO_PASSWORD=
DEMO_NAMESPACE=demo
