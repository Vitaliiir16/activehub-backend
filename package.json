{
  "name": "activehub-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:health": "node --import tsx scripts/check-health.ts",
    "test:smoke": "node --import tsx scripts/smoke-server.ts",
    "db:verify": "node --import tsx scripts/verify-db.ts",
    "db:init": "node --import tsx scripts/init-db.ts",
    "env:init": "node scripts/create-local-env.mjs",
    "worker": "node --import tsx scripts/worker.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "contract:check": "redocly lint docs/openapi.yaml && node scripts/check-contract.mjs",
    "test:contract": "node scripts/check-health-contract.mjs",
    "test:accounts": "node --import tsx scripts/accounts-smoke.ts",
    "test:marketplace": "node --import tsx scripts/marketplace-smoke.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@redocly/cli": "2.76.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "eslint": {
      "minimatch": "11.0.5"
    }
  }
}
